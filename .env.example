ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Only needed if your key is a personal/identity-linked key (you'll see an
# error mentioning "anthropic-workspace-id is required" without it).
# Find it at platform.claude.com under workspace settings — format wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Required for transcription (Speech to Text scope), voice cloning, and
# text-to-speech playback (Voices + Text to Speech scopes).
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional. Only needed for the synthetic video-avatar feature (a talking
# digital twin, rendered by HeyGen, as an alternative to audio-only dubbing).
# Without this set, dubbing still works fully — this is additive.
HEYGEN_API_KEY=

# Required in production: signs session cookies for the account system.
# Generate one with: openssl rand -hex 32
# In development, an insecure default is used automatically if this is unset.
SESSION_SECRET=

PORT=3101
NODE_ENV=development
